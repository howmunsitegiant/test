{
  "family": "howmun-test",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "howmun-test",
      "image": "794036769283.dkr.ecr.ap-southeast-1.amazonaws.com/howmun-test:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "FETCH_ENV_FROM_AWS",
          "value": "true"
        },
        {
          "name": "AWS_PARAM_NAME",
          "value": "/howmun-test"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-1"
        },
        {
          "name": "RUN_MIGRATIONS",
          "value": "true"
        }
      ],
      "logConfiguration": {
        "logDriver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3",
          "labels": "com.howmun.task=howmun-test"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 40
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::794036769283:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::794036769283:role/howmun-test-container-role"
}
