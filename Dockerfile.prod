# Stage 1: Builder
FROM --platform=linux/arm64 php:8.3-fpm-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    alpine-sdk \
    autoconf \
    git \
    curl \
    curl-dev \
    jpeg-dev \
    libpng-dev \
    libzip-dev \
    freetype-dev \
    sqlite-dev \
    zlib-dev \
    nodejs \
    npm

# Install PHP extensions with minimal dependencies
RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) \
    pdo \
    pdo_sqlite \
    pdo_mysql \
    curl \
    zip \
    gd \
    opcache

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Set working directory
WORKDIR /var/www/html

# Copy only composer files first for better layer caching
COPY composer.json ./
COPY composer.lock* ./

# Install PHP dependencies
RUN composer install \
    --optimize-autoloader \
    --no-dev \
    --no-scripts \
    --no-interaction

# Copy application code
COPY . .

# Generate application key if needed
RUN if [ ! -f .env ]; then cp .env.example .env || true; fi

# Run composer scripts (only if defined)
# RUN composer run-script post-install-cmd --no-interaction || true

# Build frontend assets if vite.config.js exists
# RUN if [ -f vite.config.js ]; then \
#     npm ci --legacy-peer-deps && \
#     npm run build && \
#     rm -rf node_modules; \
#     fi

# Optimize Laravel
RUN php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache

# Stage 2: Runtime
FROM --platform=linux/arm64 php:8.3-fpm-alpine

# Install runtime dependencies only
RUN apk add --no-cache \
    nginx \
    supervisor \
    curl \
    sqlite \
    zlib \
    libpng \
    libjpeg \
    libzip \
    freetype \
    libcurl \
    ca-certificates \
    bash \
    aws-cli

# Create necessary system directories
RUN mkdir -p /var/run/php-fpm \
    && mkdir -p /var/log/nginx \
    && mkdir -p /var/log/supervisor \
    && mkdir -p /run/nginx

# Copy PHP configuration from builder
COPY --from=builder /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d

# Copy Composer from builder
COPY --from=builder /usr/local/bin/composer /usr/local/bin/composer

# Copy compiled PHP extensions from builder
COPY --from=builder /usr/local/lib/php/extensions /usr/local/lib/php/extensions

# Set working directory
WORKDIR /var/www/html

# Copy application from builder (including vendor and built assets)
COPY --from=builder --chown=www-data:www-data /var/www/html /var/www/html

# Copy Docker configurations
COPY docker/php/php.ini /usr/local/etc/php/conf.d/
COPY docker/php/php-fpm.conf /usr/local/etc/php-fpm.d/zzz-custom.conf
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/supervisord/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/entrypoint.prod.sh /entrypoint.prod.sh

# Set proper permissions
RUN chmod +x /entrypoint.prod.sh && \
    chown -R www-data:www-data /var/www/html && \
    chmod -R 755 /var/www/html && \
    chmod -R 775 storage bootstrap/cache && \
    mkdir -p storage/logs bootstrap/cache && \
    touch storage/logs/laravel.log && \
    chown www-data:www-data storage/logs/laravel.log

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Expose port
EXPOSE 80

# Set entrypoint
ENTRYPOINT ["/entrypoint.prod.sh"]

# Start supervisord
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
